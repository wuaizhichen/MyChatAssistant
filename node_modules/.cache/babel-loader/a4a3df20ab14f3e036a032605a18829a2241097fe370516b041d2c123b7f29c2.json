{"ast":null,"code":"import \"core-js/modules/es.array.includes.js\";\nimport \"core-js/modules/es.iterator.constructor.js\";\nimport \"core-js/modules/es.iterator.filter.js\";\nimport { formatTime } from '@/utils';\nexport default {\n  name: 'ConversationList',\n  props: {\n    collapsed: Boolean\n  },\n  data() {\n    return {\n      searchText: ''\n    };\n  },\n  computed: {\n    conversations() {\n      return this.$store.getters['chat/sortedConversations'];\n    },\n    currentId() {\n      return this.$store.state.chat.currentConversationId;\n    },\n    filteredConversations() {\n      if (!this.searchText) return this.conversations;\n      const keyword = this.searchText.toLowerCase();\n      return this.conversations.filter(c => c.title.toLowerCase().includes(keyword));\n    }\n  },\n  methods: {\n    formatTime\n  }\n};","map":{"version":3,"names":["formatTime","name","props","collapsed","Boolean","data","searchText","computed","conversations","$store","getters","currentId","state","chat","currentConversationId","filteredConversations","keyword","toLowerCase","filter","c","title","includes","methods"],"sources":["src/components/ConversationList.vue"],"sourcesContent":["<template>\r\n  <div class=\"conversation-list\">\r\n    <div class=\"search-box\" v-if=\"!collapsed\">\r\n      <el-input\r\n        v-model=\"searchText\"\r\n        placeholder=\"搜索对话...\"\r\n        prefix-icon=\"el-icon-search\"\r\n        size=\"small\"\r\n        clearable\r\n      />\r\n    </div>\r\n    <div class=\"list-content\">\r\n      <div\r\n        v-for=\"conv in filteredConversations\"\r\n        :key=\"conv.id\"\r\n        class=\"conversation-item\"\r\n        :class=\"{ active: conv.id === currentId }\"\r\n        @click=\"$emit('select', conv.id)\"\r\n      >\r\n        <div v-if=\"collapsed\" class=\"conv-icon\" :title=\"conv.title\">💬</div>\r\n        <template v-else>\r\n          <div class=\"conv-info\">\r\n            <div class=\"conv-title\">{{ conv.title }}</div>\r\n            <div class=\"conv-time\">{{ formatTime(conv.updatedAt) }}</div>\r\n          </div>\r\n          <el-dropdown trigger=\"click\" @command=\"$emit('delete', conv.id)\" @click.native.stop>\r\n            <el-button type=\"text\" icon=\"el-icon-delete\" class=\"delete-btn\" size=\"mini\" />\r\n            <el-dropdown-menu slot=\"dropdown\">\r\n              <el-dropdown-item :command=\"conv.id\">删除</el-dropdown-item>\r\n            </el-dropdown-menu>\r\n          </el-dropdown>\r\n        </template>\r\n      </div>\r\n      <div class=\"empty-list\" v-if=\"filteredConversations.length === 0 && !collapsed\">\r\n        <span>暂无对话</span>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { formatTime } from '@/utils'\r\n\r\nexport default {\r\n  name: 'ConversationList',\r\n  props: {\r\n    collapsed: Boolean\r\n  },\r\n  data() {\r\n    return {\r\n      searchText: ''\r\n    }\r\n  },\r\n  computed: {\r\n    conversations() {\r\n      return this.$store.getters['chat/sortedConversations']\r\n    },\r\n    currentId() {\r\n      return this.$store.state.chat.currentConversationId\r\n    },\r\n    filteredConversations() {\r\n      if (!this.searchText) return this.conversations\r\n      const keyword = this.searchText.toLowerCase()\r\n      return this.conversations.filter(c =>\r\n        c.title.toLowerCase().includes(keyword)\r\n      )\r\n    }\r\n  },\r\n  methods: {\r\n    formatTime\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n.conversation-list {\r\n  flex: 1;\r\n  overflow: hidden;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n\r\n.search-box {\r\n  padding: 8px 12px;\r\n}\r\n\r\n.list-content {\r\n  flex: 1;\r\n  overflow-y: auto;\r\n  padding: 4px 8px;\r\n\r\n  &::-webkit-scrollbar {\r\n    width: 4px;\r\n  }\r\n\r\n  &::-webkit-scrollbar-thumb {\r\n    background: rgba(255, 255, 255, 0.2);\r\n    border-radius: 2px;\r\n  }\r\n}\r\n\r\n.conversation-item {\r\n  display: flex;\r\n  align-items: center;\r\n  padding: 10px 12px;\r\n  border-radius: 8px;\r\n  cursor: pointer;\r\n  color: #ececf1;\r\n  transition: background 0.2s;\r\n  margin-bottom: 2px;\r\n\r\n  &:hover {\r\n    background: rgba(255, 255, 255, 0.1);\r\n  }\r\n\r\n  &.active {\r\n    background: rgba(255, 255, 255, 0.15);\r\n  }\r\n\r\n  .conv-icon {\r\n    font-size: 20px;\r\n    text-align: center;\r\n    width: 100%;\r\n    cursor: pointer;\r\n  }\r\n\r\n  .conv-info {\r\n    flex: 1;\r\n    overflow: hidden;\r\n\r\n    .conv-title {\r\n      font-size: 14px;\r\n      white-space: nowrap;\r\n      overflow: hidden;\r\n      text-overflow: ellipsis;\r\n    }\r\n\r\n    .conv-time {\r\n      font-size: 12px;\r\n      color: #8e8ea0;\r\n      margin-top: 2px;\r\n    }\r\n  }\r\n\r\n  .delete-btn {\r\n    color: #8e8ea0;\r\n    opacity: 0;\r\n    transition: opacity 0.2s;\r\n\r\n    &:hover {\r\n      color: #ef4444;\r\n    }\r\n  }\r\n\r\n  &:hover .delete-btn {\r\n    opacity: 1;\r\n  }\r\n}\r\n\r\n.empty-list {\r\n  text-align: center;\r\n  color: #8e8ea0;\r\n  padding: 20px;\r\n  font-size: 14px;\r\n}\r\n</style>\r\n"],"mappings":";;;AAyCA,SAAAA,UAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACAC,SAAA,EAAAC;EACA;EACAC,KAAA;IACA;MACAC,UAAA;IACA;EACA;EACAC,QAAA;IACAC,cAAA;MACA,YAAAC,MAAA,CAAAC,OAAA;IACA;IACAC,UAAA;MACA,YAAAF,MAAA,CAAAG,KAAA,CAAAC,IAAA,CAAAC,qBAAA;IACA;IACAC,sBAAA;MACA,UAAAT,UAAA,cAAAE,aAAA;MACA,MAAAQ,OAAA,QAAAV,UAAA,CAAAW,WAAA;MACA,YAAAT,aAAA,CAAAU,MAAA,CAAAC,CAAA,IACAA,CAAA,CAAAC,KAAA,CAAAH,WAAA,GAAAI,QAAA,CAAAL,OAAA,CACA;IACA;EACA;EACAM,OAAA;IACAtB;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}