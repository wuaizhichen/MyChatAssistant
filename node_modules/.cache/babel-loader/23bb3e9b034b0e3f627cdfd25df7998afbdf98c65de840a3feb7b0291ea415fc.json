{"ast":null,"code":"export default {\n  name: 'ChatInput',\n  props: {\n    disabled: Boolean\n  },\n  data() {\n    return {\n      inputText: ''\n    };\n  },\n  methods: {\n    handleKeydown(e) {\n      if (e.key === 'Enter' && !e.shiftKey) {\n        e.preventDefault();\n        this.handleSend();\n      }\n    },\n    handleSend() {\n      const text = this.inputText.trim();\n      if (!text || this.disabled) return;\n      this.$emit('send', text);\n      this.inputText = '';\n    }\n  }\n};","map":{"version":3,"names":["name","props","disabled","Boolean","data","inputText","methods","handleKeydown","e","key","shiftKey","preventDefault","handleSend","text","trim","$emit"],"sources":["src/components/ChatInput.vue"],"sourcesContent":["<template>\r\n  <div class=\"chat-input\">\r\n    <div class=\"input-wrapper\">\r\n      <el-input\r\n        ref=\"inputRef\"\r\n        v-model=\"inputText\"\r\n        type=\"textarea\"\r\n        :autosize=\"{ minRows: 1, maxRows: 6 }\"\r\n        placeholder=\"输入消息... (Enter 发送，Shift+Enter 换行)\"\r\n        :disabled=\"disabled\"\r\n        @keydown.native=\"handleKeydown\"\r\n      />\r\n      <div class=\"input-actions\">\r\n        <el-button\r\n          v-if=\"disabled\"\r\n          type=\"danger\"\r\n          circle\r\n          size=\"small\"\r\n          icon=\"el-icon-video-pause\"\r\n          @click=\"$emit('stop')\"\r\n        />\r\n        <el-button\r\n          v-else\r\n          type=\"primary\"\r\n          circle\r\n          size=\"small\"\r\n          icon=\"el-icon-s-promotion\"\r\n          :disabled=\"!inputText.trim()\"\r\n          @click=\"handleSend\"\r\n        />\r\n      </div>\r\n    </div>\r\n    <div class=\"input-footer\">\r\n      <span class=\"footer-text\">AI 可能会犯错，请核实重要信息</span>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'ChatInput',\r\n  props: {\r\n    disabled: Boolean\r\n  },\r\n  data() {\r\n    return {\r\n      inputText: ''\r\n    }\r\n  },\r\n  methods: {\r\n    handleKeydown(e) {\r\n      if (e.key === 'Enter' && !e.shiftKey) {\r\n        e.preventDefault()\r\n        this.handleSend()\r\n      }\r\n    },\r\n    handleSend() {\r\n      const text = this.inputText.trim()\r\n      if (!text || this.disabled) return\r\n      this.$emit('send', text)\r\n      this.inputText = ''\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n.chat-input {\r\n  max-width: 800px;\r\n  margin: 0 auto;\r\n  width: 100%;\r\n}\r\n\r\n.input-wrapper {\r\n  display: flex;\r\n  align-items: flex-end;\r\n  gap: 8px;\r\n  background: #f7f7f8;\r\n  border: 1px solid #e5e5e5;\r\n  border-radius: 12px;\r\n  padding: 8px 12px;\r\n  transition: border-color 0.2s;\r\n\r\n  &:focus-within {\r\n    border-color: #409eff;\r\n    box-shadow: 0 0 0 2px rgba(64, 158, 255, 0.1);\r\n  }\r\n\r\n  ::v-deep .el-textarea__inner {\r\n    border: none;\r\n    background: transparent;\r\n    resize: none;\r\n    padding: 4px 0;\r\n    font-size: 15px;\r\n    line-height: 1.5;\r\n    box-shadow: none !important;\r\n  }\r\n}\r\n\r\n.input-actions {\r\n  flex-shrink: 0;\r\n  display: flex;\r\n  align-items: center;\r\n}\r\n\r\n.input-footer {\r\n  text-align: center;\r\n  margin-top: 8px;\r\n\r\n  .footer-text {\r\n    font-size: 12px;\r\n    color: #b4b4b4;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AAuCA;EACAA,IAAA;EACAC,KAAA;IACAC,QAAA,EAAAC;EACA;EACAC,KAAA;IACA;MACAC,SAAA;IACA;EACA;EACAC,OAAA;IACAC,cAAAC,CAAA;MACA,IAAAA,CAAA,CAAAC,GAAA,iBAAAD,CAAA,CAAAE,QAAA;QACAF,CAAA,CAAAG,cAAA;QACA,KAAAC,UAAA;MACA;IACA;IACAA,WAAA;MACA,MAAAC,IAAA,QAAAR,SAAA,CAAAS,IAAA;MACA,KAAAD,IAAA,SAAAX,QAAA;MACA,KAAAa,KAAA,SAAAF,IAAA;MACA,KAAAR,SAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}