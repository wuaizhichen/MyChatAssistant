{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport ConversationList from '@/components/ConversationList.vue';\nexport default {\n  name: 'ChatLayout',\n  components: {\n    ConversationList\n  },\n  data() {\n    return {\n      sidebarCollapsed: false\n    };\n  },\n  created() {\n    this.$store.dispatch('chat/fetchConversations');\n  },\n  methods: {\n    async handleNewChat() {\n      try {\n        await this.$store.dispatch('chat/createConversation', '新对话');\n        this.$router.push('/chat');\n      } catch (err) {\n        this.$message.error('创建对话失败');\n      }\n    },\n    handleSelectConversation(id) {\n      this.$store.dispatch('chat/selectConversation', id);\n      this.$router.push(`/chat/${id}`);\n    },\n    handleDeleteConversation(id) {\n      this.$confirm('确定删除此对话？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.$store.dispatch('chat/deleteConversation', id);\n        this.$message.success('已删除');\n      }).catch(() => {});\n    },\n    handleLogout() {\n      this.$confirm('确定退出登录？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(() => {\n        this.$store.dispatch('user/logout');\n        this.$router.push('/login');\n      }).catch(() => {});\n    }\n  }\n};","map":{"version":3,"names":["ConversationList","name","components","data","sidebarCollapsed","created","$store","dispatch","methods","handleNewChat","$router","push","err","$message","error","handleSelectConversation","id","handleDeleteConversation","$confirm","confirmButtonText","cancelButtonText","type","then","success","catch","handleLogout"],"sources":["src/views/ChatLayout.vue"],"sourcesContent":["<template>\r\n  <div class=\"chat-layout\">\r\n    <div class=\"sidebar\" :class=\"{ collapsed: sidebarCollapsed }\">\r\n      <div class=\"sidebar-header\">\r\n        <el-button\r\n          type=\"primary\"\r\n          icon=\"el-icon-plus\"\r\n          size=\"small\"\r\n          round\r\n          @click=\"handleNewChat\"\r\n          class=\"new-chat-btn\"\r\n        >\r\n          <span v-show=\"!sidebarCollapsed\">新建对话</span>\r\n        </el-button>\r\n        <el-button\r\n          :icon=\"sidebarCollapsed ? 'el-icon-s-unfold' : 'el-icon-s-fold'\"\r\n          size=\"small\"\r\n          circle\r\n          @click=\"sidebarCollapsed = !sidebarCollapsed\"\r\n          class=\"collapse-btn\"\r\n        />\r\n      </div>\r\n      <ConversationList\r\n        :collapsed=\"sidebarCollapsed\"\r\n        @select=\"handleSelectConversation\"\r\n        @delete=\"handleDeleteConversation\"\r\n      />\r\n      <div class=\"sidebar-footer\">\r\n        <el-button\r\n          type=\"text\"\r\n          icon=\"el-icon-setting\"\r\n          @click=\"$router.push('/settings')\"\r\n          class=\"footer-btn\"\r\n        >\r\n          <span v-show=\"!sidebarCollapsed\">设置</span>\r\n        </el-button>\r\n        <el-button\r\n          type=\"text\"\r\n          icon=\"el-icon-switch-button\"\r\n          @click=\"handleLogout\"\r\n          class=\"footer-btn\"\r\n        >\r\n          <span v-show=\"!sidebarCollapsed\">退出</span>\r\n        </el-button>\r\n      </div>\r\n    </div>\r\n    <div class=\"main-content\">\r\n      <router-view />\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport ConversationList from '@/components/ConversationList.vue'\r\n\r\nexport default {\r\n  name: 'ChatLayout',\r\n  components: { ConversationList },\r\n  data() {\r\n    return {\r\n      sidebarCollapsed: false\r\n    }\r\n  },\r\n  created() {\r\n    this.$store.dispatch('chat/fetchConversations')\r\n  },\r\n  methods: {\r\n    async handleNewChat() {\r\n      try {\r\n        await this.$store.dispatch('chat/createConversation', '新对话')\r\n        this.$router.push('/chat')\r\n      } catch (err) {\r\n        this.$message.error('创建对话失败')\r\n      }\r\n    },\r\n    handleSelectConversation(id) {\r\n      this.$store.dispatch('chat/selectConversation', id)\r\n      this.$router.push(`/chat/${id}`)\r\n    },\r\n    handleDeleteConversation(id) {\r\n      this.$confirm('确定删除此对话？', '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        this.$store.dispatch('chat/deleteConversation', id)\r\n        this.$message.success('已删除')\r\n      }).catch(() => {})\r\n    },\r\n    handleLogout() {\r\n      this.$confirm('确定退出登录？', '提示', {\r\n        confirmButtonText: '确定',\r\n        cancelButtonText: '取消',\r\n        type: 'warning'\r\n      }).then(() => {\r\n        this.$store.dispatch('user/logout')\r\n        this.$router.push('/login')\r\n      }).catch(() => {})\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"scss\" scoped>\r\n.chat-layout {\r\n  display: flex;\r\n  height: 100vh;\r\n  overflow: hidden;\r\n  background: #f5f5f5;\r\n}\r\n\r\n.sidebar {\r\n  width: 260px;\r\n  background: #202123;\r\n  display: flex;\r\n  flex-direction: column;\r\n  transition: width 0.3s ease;\r\n  flex-shrink: 0;\r\n\r\n  &.collapsed {\r\n    width: 64px;\r\n  }\r\n}\r\n\r\n.sidebar-header {\r\n  padding: 12px;\r\n  display: flex;\r\n  gap: 8px;\r\n  align-items: center;\r\n\r\n  .new-chat-btn {\r\n    flex: 1;\r\n  }\r\n\r\n  .collapse-btn {\r\n    background: rgba(255, 255, 255, 0.1);\r\n    border: none;\r\n    color: #fff;\r\n\r\n    &:hover {\r\n      background: rgba(255, 255, 255, 0.2);\r\n    }\r\n  }\r\n}\r\n\r\n.sidebar-footer {\r\n  padding: 12px;\r\n  border-top: 1px solid rgba(255, 255, 255, 0.1);\r\n  display: flex;\r\n  justify-content: space-around;\r\n\r\n  .footer-btn {\r\n    color: #b4b4b4;\r\n    font-size: 14px;\r\n\r\n    &:hover {\r\n      color: #fff;\r\n    }\r\n  }\r\n}\r\n\r\n.main-content {\r\n  flex: 1;\r\n  overflow: hidden;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\n</style>\r\n"],"mappings":";AAqDA,OAAAA,