{"ast":null,"code":"import MarkdownIt from 'markdown-it';\nimport hljs from 'highlight.js';\nexport default {\n  name: 'MarkdownRenderer',\n  props: {\n    content: {\n      type: String,\n      default: ''\n    },\n    isStreaming: {\n      type: Boolean,\n      default: false\n    }\n  },\n  computed: {\n    renderedContent() {\n      const md = new MarkdownIt({\n        html: false,\n        linkify: true,\n        typographer: true,\n        highlight: (str, lang) => {\n          if (lang && hljs.getLanguage(lang)) {\n            try {\n              return '<pre class=\"hljs\"><code>' + hljs.highlight(str, {\n                language: lang,\n                ignoreIllegals: true\n              }).value + '</code></pre>';\n            } catch (__) {}\n          }\n          return '<pre class=\"hljs\"><code>' + md.utils.escapeHtml(str) + '</code></pre>';\n        }\n      });\n      let result = md.render(this.content || '');\n      if (this.isStreaming) {\n        result = result.replace(/<\\/code><\\/pre>$/, '<span class=\"streaming-cursor\">▋</span></code></pre>');\n      }\n      return result;\n    }\n  }\n};","map":{"version":3,"names":["MarkdownIt","hljs","name","props","content","type","String","default","isStreaming","Boolean","computed","renderedContent","md","html","linkify","typographer","highlight","str","lang","getLanguage","language","ignoreIllegals","value","__","utils","escapeHtml","result","render","replace"],"sources":["src/components/MarkdownRenderer.vue"],"sourcesContent":["<template>\n  <div class=\"markdown-renderer\" v-html=\"renderedContent\"></div>\n</template>\n\n<script>\nimport MarkdownIt from 'markdown-it'\nimport hljs from 'highlight.js'\n\nexport default {\n  name: 'MarkdownRenderer',\n  props: {\n    content: {\n      type: String,\n      default: ''\n    },\n    isStreaming: {\n      type: Boolean,\n      default: false\n    }\n  },\n  computed: {\n    renderedContent() {\n      const md = new MarkdownIt({\n        html: false,\n        linkify: true,\n        typographer: true,\n        highlight: (str, lang) => {\n          if (lang && hljs.getLanguage(lang)) {\n            try {\n              return '<pre class=\"hljs\"><code>' +\n                hljs.highlight(str, { language: lang, ignoreIllegals: true }).value +\n                '</code></pre>'\n            } catch (__) {}\n          }\n          return '<pre class=\"hljs\"><code>' + md.utils.escapeHtml(str) + '</code></pre>'\n        }\n      })\n\n      let result = md.render(this.content || '')\n      if (this.isStreaming) {\n        result = result.replace(/<\\/code><\\/pre>$/, '<span class=\"streaming-cursor\">▋</span></code></pre>')\n      }\n      return result\n    }\n  }\n}\n</script>\n\n<style lang=\"scss\">\n.markdown-renderer {\n  line-height: 1.7;\n  word-break: break-word;\n\n  code {\n    background: #f5f5f5;\n    padding: 2px 6px;\n    border-radius: 4px;\n    font-family: 'Courier New', Courier, monospace;\n    font-size: 0.9em;\n  }\n\n  pre {\n    background: #1e1e1e;\n    border-radius: 8px;\n    padding: 16px;\n    overflow-x: auto;\n    margin: 12px 0;\n\n    code {\n      background: transparent;\n      padding: 0;\n      color: #d4d4d4;\n      font-size: 14px;\n      line-height: 1.5;\n    }\n  }\n\n  p {\n    margin: 8px 0;\n  }\n\n  ul, ol {\n    padding-left: 24px;\n    margin: 8px 0;\n  }\n\n  li {\n    margin: 4px 0;\n  }\n\n  blockquote {\n    border-left: 4px solid #ddd;\n    padding-left: 16px;\n    margin: 12px 0;\n    color: #666;\n  }\n\n  a {\n    color: #409eff;\n    text-decoration: none;\n\n    &:hover {\n      text-decoration: underline;\n    }\n  }\n\n  table {\n    border-collapse: collapse;\n    width: 100%;\n    margin: 12px 0;\n\n    th, td {\n      border: 1px solid #ddd;\n      padding: 8px 12px;\n      text-align: left;\n    }\n\n    th {\n      background: #f5f5f5;\n    }\n  }\n\n  .streaming-cursor {\n    display: inline-block;\n    animation: blink 1s infinite;\n    color: #409eff;\n    font-weight: bold;\n  }\n\n  @keyframes blink {\n    0%, 50% { opacity: 1; }\n    51%, 100% { opacity: 0; }\n  }\n}\n</style>\n"],"mappings":"AAKA,OAAAA,UAAA;AACA,OAAAC,IAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACAC,OAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;IACAC,WAAA;MACAH,IAAA,EAAAI,OAAA;MACAF,OAAA;IACA;EACA;EACAG,QAAA;IACAC,gBAAA;MACA,MAAAC,EAAA,OAAAZ,UAAA;QACAa,IAAA;QACAC,OAAA;QACAC,WAAA;QACAC,SAAA,EAAAA,CAAAC,GAAA,EAAAC,IAAA;UACA,IAAAA,IAAA,IAAAjB,IAAA,CAAAkB,WAAA,CAAAD,IAAA;YACA;cACA,oCACAjB,IAAA,CAAAe,SAAA,CAAAC,GAAA;gBAAAG,QAAA,EAAAF,IAAA;gBAAAG,cAAA;cAAA,GAAAC,KAAA,GACA;YACA,SAAAC,EAAA;UACA;UACA,oCAAAX,EAAA,CAAAY,KAAA,CAAAC,UAAA,CAAAR,GAAA;QACA;MACA;MAEA,IAAAS,MAAA,GAAAd,EAAA,CAAAe,MAAA,MAAAvB,OAAA;MACA,SAAAI,WAAA;QACAkB,MAAA,GAAAA,MAAA,CAAAE,OAAA;MACA;MACA,OAAAF,MAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}