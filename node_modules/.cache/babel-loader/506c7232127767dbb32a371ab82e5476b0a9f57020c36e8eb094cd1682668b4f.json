{"ast":null,"code":"import { renderMarkdown } from '@/utils';\nexport default {\n  name: 'MarkdownRenderer',\n  props: {\n    content: {\n      type: String,\n      default: ''\n    },\n    isStreaming: {\n      type: Boolean,\n      default: false\n    }\n  },\n  data() {\n    return {\n      displayedLength: 0,\n      typingInterval: null\n    };\n  },\n  computed: {\n    displayedContent() {\n      const text = this.content;\n      if (this.isStreaming && this.displayedLength < text.length) {\n        return renderMarkdown(text.substring(0, this.displayedLength));\n      }\n      return renderMarkdown(text);\n    },\n    hasMoreContent() {\n      return this.isStreaming && this.displayedLength < this.content.length;\n    }\n  },\n  watch: {\n    content: {\n      handler(newContent) {\n        if (this.isStreaming) {\n          this.startTypingEffect(newContent);\n        } else {\n          this.displayedLength = newContent.length;\n        }\n      },\n      immediate: true\n    },\n    isStreaming(newVal) {\n      if (newVal) {\n        this.startTypingEffect(this.content);\n      } else {\n        this.stopTypingEffect();\n        this.displayedLength = this.content.length;\n      }\n    }\n  },\n  beforeDestroy() {\n    this.stopTypingEffect();\n  },\n  methods: {\n    startTypingEffect(text) {\n      this.stopTypingEffect();\n      if (!text || text.length === 0) {\n        this.displayedLength = 0;\n        return;\n      }\n      const targetLength = text.length;\n      let currentLength = 0;\n      const tick = () => {\n        if (currentLength < targetLength) {\n          currentLength += 1;\n          this.displayedLength = currentLength;\n        } else {\n          this.stopTypingEffect();\n        }\n      };\n      this.typingInterval = setInterval(tick, 30);\n      tick();\n    },\n    stopTypingEffect() {\n      if (this.typingInterval) {\n        clearInterval(this.typingInterval);\n        this.typingInterval = null;\n      }\n    }\n  }\n};","map":{"version":3,"names":["renderMarkdown","name","props","content","type","String","default","isStreaming","Boolean","data","displayedLength","typingInterval","computed","displayedContent","text","length","substring","hasMoreContent","watch","handler","newContent","startTypingEffect","immediate","newVal","stopTypingEffect","beforeDestroy","methods","targetLength","currentLength","tick","setInterval","clearInterval"],"sources":["src/components/MarkdownRenderer.vue"],"sourcesContent":["<template>\r\n  <div class=\"markdown-renderer\" :class=\"{ 'is-streaming': isStreaming }\">\r\n    <div v-html=\"displayedContent\"></div>\r\n    <span class=\"typing-cursor\" v-if=\"isStreaming && hasMoreContent\"></span>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { renderMarkdown } from '@/utils'\r\n\r\nexport default {\r\n  name: 'MarkdownRenderer',\r\n  props: {\r\n    content: {\r\n      type: String,\r\n      default: ''\r\n    },\r\n    isStreaming: {\r\n      type: Boolean,\r\n      default: false\r\n    }\r\n  },\r\n  data() {\r\n    return {\r\n      displayedLength: 0,\r\n      typingInterval: null\r\n    }\r\n  },\r\n  computed: {\r\n    displayedContent() {\r\n      const text = this.content\r\n      if (this.isStreaming && this.displayedLength < text.length) {\r\n        return renderMarkdown(text.substring(0, this.displayedLength))\r\n      }\r\n      return renderMarkdown(text)\r\n    },\r\n    hasMoreContent() {\r\n      return this.isStreaming && this.displayedLength < this.content.length\r\n    }\r\n  },\r\n  watch: {\r\n    content: {\r\n      handler(newContent) {\r\n        if (this.isStreaming) {\r\n          this.startTypingEffect(newContent)\r\n        } else {\r\n          this.displayedLength = newContent.length\r\n        }\r\n      },\r\n      immediate: true\r\n    },\r\n    isStreaming(newVal) {\r\n      if (newVal) {\r\n        this.startTypingEffect(this.content)\r\n      } else {\r\n        this.stopTypingEffect()\r\n        this.displayedLength = this.content.length\r\n      }\r\n    }\r\n  },\r\n  beforeDestroy() {\r\n    this.stopTypingEffect()\r\n  },\r\n  methods: {\r\n    startTypingEffect(text) {\r\n      this.stopTypingEffect()\r\n      \r\n      if (!text || text.length === 0) {\r\n        this.displayedLength = 0\r\n        return\r\n      }\r\n\r\n      const targetLength = text.length\r\n      let currentLength = 0\r\n      \r\n      const tick = () => {\r\n        if (currentLength < targetLength) {\r\n          currentLength += 1\r\n          this.displayedLength = currentLength\r\n        } else {\r\n          this.stopTypingEffect()\r\n        }\r\n      }\r\n\r\n      this.typingInterval = setInterval(tick, 30)\r\n      tick()\r\n    },\r\n    stopTypingEffect() {\r\n      if (this.typingInterval) {\r\n        clearInterval(this.typingInterval)\r\n        this.typingInterval = null\r\n      }\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style lang=\"scss\">\r\n.markdown-renderer {\r\n  font-size: 15px;\r\n  line-height: 1.7;\r\n  color: #333;\r\n  word-break: break-word;\r\n\r\n  p {\r\n    margin: 0 0 12px;\r\n\r\n    &:last-child {\r\n      margin-bottom: 0;\r\n    }\r\n  }\r\n\r\n  h1, h2, h3, h4, h5, h6 {\r\n    margin: 20px 0 10px;\r\n    font-weight: 600;\r\n    line-height: 1.4;\r\n  }\r\n\r\n  h1 { font-size: 1.6em; }\r\n  h2 { font-size: 1.4em; }\r\n  h3 { font-size: 1.2em; }\r\n\r\n  ul, ol {\r\n    padding-left: 24px;\r\n    margin: 8px 0;\r\n  }\r\n\r\n  li {\r\n    margin: 4px 0;\r\n  }\r\n\r\n  blockquote {\r\n    margin: 12px 0;\r\n    padding: 8px 16px;\r\n    border-left: 4px solid #ddd;\r\n    background: #f9f9f9;\r\n    color: #666;\r\n  }\r\n\r\n  a {\r\n    color: #409eff;\r\n    text-decoration: none;\r\n\r\n    &:hover {\r\n      text-decoration: underline;\r\n    }\r\n  }\r\n\r\n  table {\r\n    border-collapse: collapse;\r\n    width: 100%;\r\n    margin: 12px 0;\r\n\r\n    th, td {\r\n      border: 1px solid #ddd;\r\n      padding: 8px 12px;\r\n      text-align: left;\r\n    }\r\n\r\n    th {\r\n      background: #f5f5f5;\r\n      font-weight: 600;\r\n    }\r\n\r\n    tr:nth-child(even) {\r\n      background: #fafafa;\r\n    }\r\n  }\r\n\r\n  code {\r\n    background: #f0f0f0;\r\n    padding: 2px 6px;\r\n    border-radius: 4px;\r\n    font-size: 0.9em;\r\n    font-family: 'Menlo', 'Monaco', 'Courier New', monospace;\r\n  }\r\n\r\n  .hljs-code-block {\r\n    margin: 12px 0;\r\n    border-radius: 8px;\r\n    overflow: hidden;\r\n    background: #1e1e1e;\r\n\r\n    .code-header {\r\n      display: flex;\r\n      justify-content: space-between;\r\n      align-items: center;\r\n      padding: 6px 12px;\r\n      background: #2d2d2d;\r\n\r\n      .code-lang {\r\n        color: #999;\r\n        font-size: 12px;\r\n      }\r\n\r\n      .copy-btn {\r\n        background: none;\r\n        border: 1px solid #555;\r\n        color: #ccc;\r\n        padding: 2px 8px;\r\n        border-radius: 4px;\r\n        font-size: 12px;\r\n        cursor: pointer;\r\n\r\n        &:hover {\r\n          background: #3d3d3d;\r\n          color: #fff;\r\n        }\r\n      }\r\n    }\r\n\r\n    code {\r\n      display: block;\r\n      padding: 16px;\r\n      overflow-x: auto;\r\n      background: transparent;\r\n      color: #d4d4d4;\r\n      font-size: 14px;\r\n      line-height: 1.5;\r\n    }\r\n  }\r\n\r\n  hr {\r\n    border: none;\r\n    border-top: 1px solid #e8e8e8;\r\n    margin: 16px 0;\r\n  }\r\n\r\n  img {\r\n    max-width: 100%;\r\n    border-radius: 8px;\r\n  }\r\n}\r\n\r\n.markdown-renderer.is-streaming {\r\n  position: relative;\r\n\r\n  .typing-cursor {\r\n    display: inline-block;\r\n    width: 2px;\r\n    height: 1.2em;\r\n    background: #333;\r\n    vertical-align: text-bottom;\r\n    animation: blink 0.8s infinite;\r\n    margin-left: 2px;\r\n  }\r\n}\r\n\r\n@keyframes blink {\r\n  0%, 50% {\r\n    opacity: 1;\r\n  }\r\n  51%, 100% {\r\n    opacity: 0;\r\n  }\r\n}\r\n\r\n@keyframes fadeIn {\r\n  from {\r\n    opacity: 0.8;\r\n  }\r\n  to {\r\n    opacity: 1;\r\n  }\r\n}\r\n</style>\r\n"],"mappings":"AAQA,SAAAA,cAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACAC,OAAA;MACAC,IAAA,EAAAC,MAAA;MACAC,OAAA;IACA;IACAC,WAAA;MACAH,IAAA,EAAAI,OAAA;MACAF,OAAA;IACA;EACA;EACAG,KAAA;IACA;MACAC,eAAA;MACAC,cAAA;IACA;EACA;EACAC,QAAA;IACAC,iBAAA;MACA,MAAAC,IAAA,QAAAX,OAAA;MACA,SAAAI,WAAA,SAAAG,eAAA,GAAAI,IAAA,CAAAC,MAAA;QACA,OAAAf,cAAA,CAAAc,IAAA,CAAAE,SAAA,SAAAN,eAAA;MACA;MACA,OAAAV,cAAA,CAAAc,IAAA;IACA;IACAG,eAAA;MACA,YAAAV,WAAA,SAAAG,eAAA,QAAAP,OAAA,CAAAY,MAAA;IACA;EACA;EACAG,KAAA;IACAf,OAAA;MACAgB,QAAAC,UAAA;QACA,SAAAb,WAAA;UACA,KAAAc,iBAAA,CAAAD,UAAA;QACA;UACA,KAAAV,eAAA,GAAAU,UAAA,CAAAL,MAAA;QACA;MACA;MACAO,SAAA;IACA;IACAf,YAAAgB,MAAA;MACA,IAAAA,MAAA;QACA,KAAAF,iBAAA,MAAAlB,OAAA;MACA;QACA,KAAAqB,gBAAA;QACA,KAAAd,eAAA,QAAAP,OAAA,CAAAY,MAAA;MACA;IACA;EACA;EACAU,cAAA;IACA,KAAAD,gBAAA;EACA;EACAE,OAAA;IACAL,kBAAAP,IAAA;MACA,KAAAU,gBAAA;MAEA,KAAAV,IAAA,IAAAA,IAAA,CAAAC,MAAA;QACA,KAAAL,eAAA;QACA;MACA;MAEA,MAAAiB,YAAA,GAAAb,IAAA,CAAAC,MAAA;MACA,IAAAa,aAAA;MAEA,MAAAC,IAAA,GAAAA,CAAA;QACA,IAAAD,aAAA,GAAAD,YAAA;UACAC,aAAA;UACA,KAAAlB,eAAA,GAAAkB,aAAA;QACA;UACA,KAAAJ,gBAAA;QACA;MACA;MAEA,KAAAb,cAAA,GAAAmB,WAAA,CAAAD,IAAA;MACAA,IAAA;IACA;IACAL,iBAAA;MACA,SAAAb,cAAA;QACAoB,aAAA,MAAApB,cAAA;QACA,KAAAA,cAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}